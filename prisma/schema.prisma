// Panthera Properties — data model
// PostgreSQL via Prisma. Run `npm run db:push` to sync, `npm run db:seed` for sample data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  APARTMENT
  PENTHOUSE
  HOUSE
  VILLA
  LAND
  COMMERCIAL
}

enum ListingStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
}

enum LeadType {
  PROPERTY_INQUIRY
  VIEWING_REQUEST
  SELL_PROPERTY
  CONSULTATION
  ASSISTANT_REQUIREMENTS
}

enum LeadStatus {
  NEW
  CONTACTED
  VIEWING_SCHEDULED
  NEGOTIATING
  CLOSED
}

model Neighborhood {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  district    String     @default("Colombo")
  tagline     String?
  description String?    @db.Text
  imageUrl    String?
  lat         Float?
  lng         Float?
  sortOrder   Int        @default(0)
  properties  Property[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Property {
  id             String          @id @default(cuid())
  slug           String          @unique
  title          String
  summary        String?
  description    String          @db.Text
  type           PropertyType
  status         ListingStatus   @default(AVAILABLE)
  published      Boolean         @default(true)
  featured       Boolean         @default(false)
  investment     Boolean         @default(false)
  // Sample listings are seeded for testing only and are always labelled as such in the UI.
  isSample       Boolean         @default(false)
  price          Float?
  priceOnRequest Boolean         @default(false)
  bedrooms       Int?
  bathrooms      Int?
  floorArea      Int? // square feet
  landExtent     Float? // perches
  address        String?
  lat            Float?
  lng            Float?
  features       String[]
  amenities      String[]
  virtualTourUrl String?
  videoUrl       String?
  neighborhoodId String
  neighborhood   Neighborhood    @relation(fields: [neighborhoodId], references: [id])
  images         PropertyImage[]
  leads          Lead[]
  listedAt       DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([type, status, published])
  @@index([neighborhoodId])
  @@index([price])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  // Cloud storage identifier (Cloudinary public_id) or local media id, used for clean-up.
  storageKey String?
  createdAt  DateTime @default(now())

  @@index([propertyId, sortOrder])
}

// Fallback media store when no cloud image storage is configured.
model MediaFile {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

model Lead {
  id            String     @id @default(cuid())
  type          LeadType
  status        LeadStatus @default(NEW)
  name          String
  email         String
  phone         String?
  message       String?    @db.Text
  preferredDate DateTime?
  preferredTime String?
  // Structured extras: seller property details, assistant search requirements, etc.
  details       Json?
  source        String?
  propertyId    String?
  property      Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  adminNotes    String?    @db.Text
  emailNotified Boolean    @default(false)
  ipHash        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([type])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

// Editable site content (homepage copy, hero media, logo) stored as JSON by key.
model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
