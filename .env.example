# ── Required ────────────────────────────────────────────────
# PostgreSQL connection string (Replit: provided automatically when you add a PostgreSQL database)
DATABASE_URL="postgresql://postgres:panthera@localhost:5433/panthera"
# Long random string used to sign admin sessions. Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Public URL of the site (used for SEO, sitemap, Open Graph and WhatsApp links)
NEXT_PUBLIC_SITE_URL="https://pantheraproperties.lk"

# ── First admin account (used by `npm run db:seed` / `npm run admin:create`) ──
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# ── Optional: cloud image storage (Cloudinary). Without it, uploads are stored in PostgreSQL. ──
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="panthera"

# ── Optional: email notifications for new enquiries (SMTP) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Panthera Properties <no-reply@pantheraproperties.lk>"
NOTIFY_EMAIL=""

# ── Optional: AI property assistant (Anthropic Claude). Without it, a rule-based parser is used. ──
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
